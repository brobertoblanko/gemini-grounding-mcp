{
  "config": {
    // The docs put every complete sentence on its own line so that diffs stay
    // readable sentence by sentence. A hard column limit contradicts that
    // directly: it forces either a break mid-sentence or bundling short
    // sentences. Line length is therefore not checked.
    "MD013": false,

    // Collapsible sections exist in Markdown only as HTML. GitHub documents the
    // pattern officially, and npmjs.com serves both elements unchanged, checked
    // against a real package page. Other HTML tags stay forbidden.
    "MD033": {
      "allowed_elements": ["details", "summary"]
    }
  },
  // plans/ and issues/ are in .gitignore: local notes that are not part of the
  // published repo and must not turn the lint red.
  //
  // google_terms.md as well, but for a different reason: it is a verbatim working
  // copy of Google's terms of service. The lint flags six places in it, all of
  // which could only be fixed by changing the legal text, and nobody may do that
  // to a reference copy. A quotation reformatted to taste is worthless as
  // evidence.
  "globs": [
    "**/*.md",
    "!node_modules",
    "!**/plans",
    "!**/issues",
    "!**/google_terms.md"
  ]
}
